{
  "info": {
    "name": "StudentTrack API Tests",
    "description": "EC4206 Member 3 - API automation for StudentTrack (Express backend). Non-destructive: only reads data or sends requests that must be rejected. Names show the matching Member 1 test case / decision-table rule in [brackets]. Run with Newman via `npm run test:api`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API-01 [TC009, DT-R5] Login - approved student, correct password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Returns a JWT token\", () => { pm.expect(body.token).to.be.a(\"string\"); pm.expect(body.token.split(\".\")).to.have.lengthOf(3); });",
              "pm.test(\"User role is student\", () => pm.expect(body.user.role).to.eql(\"student\"));",
              "pm.test(\"Email matches the login email\", () => pm.expect(body.user.email).to.eql(pm.variables.get(\"studentEmail\")));",
              "pm.test(\"Password hash is not exposed\", () => pm.expect(body.user).to.not.have.property(\"password\"));",
              "pm.test(\"Responds within 2 seconds\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
              "// Save the token for the authenticated requests below",
              "pm.collectionVariables.set(\"token\", body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Positive login. Saves the token for later requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
