# Copy this file to .env (same folder) and fill in the password.
# .env is git-ignored - never commit real values.

# Password used for BOTH synthetic test accounts (8+ characters, anything you like)
TEST_STUDENT_PASSWORD=

# Where the app runs locally (defaults shown)
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api

# Set to false to watch Chrome while the Selenium tests run
HEADLESS=false